# Contact form email delivery (Resend — https://resend.com).
# Copy to .env.local and fill in. Without RESEND_API_KEY, submissions are logged to the server console.
RESEND_API_KEY=
# Inbox that receives contact form messages (required when RESEND_API_KEY is set).
CONTACT_TO_EMAIL=
# Verified sender. Defaults to Resend's sandbox sender if omitted.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
